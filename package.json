{
	"name": "rtp-course-engine",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24.22.0 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --cache && eslint . && stylelint \"src/**/*.{css,svelte}\" && node scripts/check-style-layers.js",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run --sequence.shuffle && playwright test",
		"test:e2e": "playwright test",
		"gate": "pnpm run check && pnpm run lint && pnpm run build && vitest run --sequence.shuffle && playwright test"
	},
	"devDependencies": {
		"@csstools/postcss-global-data": "4.0.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/enhanced-img": "1.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@vitest/browser-playwright": "5.0.5",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"mdsvex": "0.12.8",
		"playwright": "1.64.1",
		"postcss": "8.5.30",
		"postcss-custom-media": "12.0.3",
		"postcss-html": "2.0.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"stylelint": "17.16.0",
		"stylelint-config-html": "2.0.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
